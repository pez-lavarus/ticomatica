{
  "name": "examen-matematicas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm --filter @bxm/web dev",
    "build": "pnpm --filter @bxm/web build",
    "start": "pnpm --filter @bxm/web start",
    "lint": "pnpm --filter @bxm/web lint",
    "typecheck": "pnpm --filter @bxm/web typecheck && pnpm --filter @bxm/infra typecheck",
    "test": "pnpm --filter @bxm/web test",
    "infra:synth": "pnpm --filter @bxm/infra synth",
    "infra:diff": "pnpm --filter @bxm/infra diff",
    "infra:deploy": "pnpm --filter @bxm/infra deploy"
  }
}
