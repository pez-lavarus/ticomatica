{
  "name": "examen-matematicas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm --filter @ticomatica/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm --filter @ticomatica/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "start": "pnpm --filter @ticomatica/web start",
    "infra:synth": "pnpm --filter @ticomatica/infrastructure synth",
    "infra:synth:dev": "pnpm --filter @ticomatica/infrastructure synth:dev",
    "infra:synth:prod": "pnpm --filter @ticomatica/infrastructure synth:prod",
    "infra:diff": "pnpm --filter @ticomatica/infrastructure diff",
    "infra:deploy": "pnpm --filter @ticomatica/infrastructure deploy",
    "infra:deploy:dev": "pnpm --filter @ticomatica/infrastructure deploy:dev",
    "infra:deploy:prod": "pnpm --filter @ticomatica/infrastructure deploy:prod",
    "infra:delete": "pnpm --filter @ticomatica/infrastructure destroy",
    "infra:delete:dev": "pnpm --filter @ticomatica/infrastructure destroy:dev",
    "infra:delete:prod": "pnpm --filter @ticomatica/infrastructure destroy:prod"
  }
}
