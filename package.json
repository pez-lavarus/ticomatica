{
  "name": "examen-matematicas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm --filter @ticomatica/web dev",
    "build": "pnpm --filter @ticomatica/web build",
    "start": "pnpm --filter @ticomatica/web start",
    "lint": "pnpm --filter @ticomatica/web lint",
    "typecheck": "pnpm --filter @ticomatica/web typecheck && pnpm --filter @ticomatica/infra typecheck",
    "test": "pnpm --filter @ticomatica/web test",
    "infra:synth": "pnpm --filter @ticomatica/infra synth",
    "infra:diff": "pnpm --filter @ticomatica/infra diff",
    "infra:deploy": "pnpm --filter @ticomatica/infra deploy"
  }
}
