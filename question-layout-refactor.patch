+    expect(planVerticalFit(tiny)).toEqual({ optionsGrid: true, graphMaxHeight: 120, scroll: "contained" });
+    expect(planVerticalFit({ ...tiny, graphIntrinsicHeight: null }).scroll).toBe("page");
