{
  "name": "@ticomatica/infrastructure",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "synth": "pnpm build && cdk synth",
    "synth:dev": "pnpm build && cdk synth -c stage=dev",
    "synth:prod": "pnpm build && cdk synth -c stage=prod",
    "diff": "cdk diff",
    "deploy": "pnpm build && cdk deploy --all --require-approval never",
    "deploy:dev": "pnpm build && cdk deploy --all -c stage=dev --require-approval never",
    "deploy:prod": "pnpm build && cdk deploy --all -c stage=prod --require-approval never",
    "destroy": "cdk destroy --all",
    "destroy:dev": "cdk destroy --all -c stage=dev",
    "destroy:prod": "cdk destroy --all -c stage=prod",
    "bootstrap": "cdk bootstrap",
    "package": "tsup && node scripts/zip-bundle.mjs"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "archiver": "^7.0.1",
    "aws-cdk": "^2.1145.0",
    "tsup": "^8.5.0",
    "typescript": "catalog:",
    "vitest": "^4.1.5"
  }
}
