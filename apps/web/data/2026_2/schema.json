{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/mep-ea-01/content.schema.json",
  "title": "MEP-EA-01 Content Schema (questions.json)",
  "type": "object",
  "required": ["schema_version", "exam", "convocatoria", "items"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "exam": { "type": "string" },
    "convocatoria": { "type": "string" },
    "language": { "type": "string" },
    "source": { "type": "string" },
    "specification": { "type": "string" },
    "solucionario_verified": { "type": "boolean" },
    "total_items": { "type": "integer" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "item_range", "total_items"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "item_range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } },
          "total_items": { "type": "integer" },
          "distribution": { "type": "object" }
        }
      }
    },
    "sets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "total_items"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "total_items": { "type": "integer" }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } }
  },
  "$defs": {
    "layoutCharacteristics": {
      "type": "object",
      "description": "Derived content facts, not viewport sizes or a forced layout. Generated by pnpm update:layout-characteristics after resolving item/group content; recomputed by the runtime bank adapter. Length field names use the corrected spelling Length.",
      "readOnly": true,
      "required": [
        "version",
        "wordNum",
        "questionStatementWordNum",
        "responseStatementWordNum",
        "responseOptionsWordNum",
        "questionStatementLength",
        "responseStatementLength",
        "largestResponseOptionLength",
        "totalResponseOptionsLength",
        "longestWordLength",
        "hasGraph",
        "hasStatementGraph",
        "hasTable",
        "hasSharedContext",
        "optionGraphNum",
        "optionNum",
        "optionContentType",
        "hasFormula",
        "formulaNum",
        "questionFormulaNum",
        "responseFormulaNum",
        "optionFormulaNum",
        "displayFormulaNum",
        "complexFormulaNum",
        "largestFormulaLength",
        "largestOptionFormulaLength",
        "questionParagraphNum",
        "responseParagraphNum",
        "longestOptionWordLength"
      ],
      "properties": {
        "version": {
          "const": 1,
          "description": "Extractor version; regenerate metrics when extraction semantics change."
        },
        "wordNum": {
          "type": "integer",
          "minimum": 0,
          "description": "Total visible prose words across statement, problem and textual options; excludes delimited math."
        },
        "questionStatementWordNum": {
          "type": "integer",
          "minimum": 0,
          "description": "question Statement Word Num. Counts use resolved, visible content; lengths use Unicode code points."
        },
        "responseStatementWordNum": {
          "type": "integer",
          "minimum": 0,
          "description": "response Statement Word Num. Counts use resolved, visible content; lengths use Unicode code points."
        },
        "responseOptionsWordNum": {
          "type": "integer",
          "minimum": 0,
          "description": "response Options Word Num. Counts use resolved, visible content; lengths use Unicode code points."
        },
        "questionStatementLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Unicode code points of the resolved statement source, including LaTeX delimiters and commands."
        },
        "responseStatementLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Unicode code points of the problem/prompt source, including LaTeX markup."
        },
        "largestResponseOptionLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Largest visible textual answer source length; image-only labels do not count."
        },
        "totalResponseOptionsLength": {
          "type": "integer",
          "minimum": 0,
          "description": "total Response Options Length. Counts use resolved, visible content; lengths use Unicode code points."
        },
        "longestWordLength": {
          "type": "integer",
          "minimum": 0,
          "description": "longest Word Length. Counts use resolved, visible content; lengths use Unicode code points."
        },
        "hasGraph": {
          "type": "boolean",
          "description": "True if the statement or any answer contains a graph; tables are tracked separately."
        },
        "hasStatementGraph": {
          "type": "boolean",
          "description": "True for a resolved statement image or structured visual other than a table."
        },
        "hasTable": {
          "type": "boolean",
          "description": "has Table. Counts use resolved, visible content; lengths use Unicode code points."
        },
        "hasSharedContext": {
          "type": "boolean",
          "description": "True when the question references a shared group_id."
        },
        "optionGraphNum": {
          "type": "integer",
          "minimum": 0,
          "description": "option Graph Num. Counts use resolved, visible content; lengths use Unicode code points."
        },
        "optionNum": {
          "type": "integer",
          "minimum": 0,
          "description": "option Num. Counts use resolved, visible content; lengths use Unicode code points."
        },
        "optionContentType": {
          "enum": [
            "text",
            "graph",
            "mixed"
          ],
          "description": "Text, graph-only, or a mixture across answer options."
        },
        "hasFormula": {
          "type": "boolean",
          "description": "has Formula. Counts use resolved, visible content; lengths use Unicode code points."
        },
        "formulaNum": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of math spans delimited by $, $$, \\( or \\[ across displayed content, excluding escaped currency dollars."
        },
        "questionFormulaNum": {
          "type": "integer",
          "minimum": 0,
          "description": "question Formula Num. Counts use resolved, visible content; lengths use Unicode code points."
        },
        "responseFormulaNum": {
          "type": "integer",
          "minimum": 0,
          "description": "response Formula Num. Counts use resolved, visible content; lengths use Unicode code points."
        },
        "optionFormulaNum": {
          "type": "integer",
          "minimum": 0,
          "description": "option Formula Num. Counts use resolved, visible content; lengths use Unicode code points."
        },
        "displayFormulaNum": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of explicitly authored $$...$$ or \\[...\\] spans."
        },
        "complexFormulaNum": {
          "type": "integer",
          "minimum": 0,
          "description": "Math spans containing fractions, roots, sums, integrals or environments."
        },
        "largestFormulaLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Largest formula source length excluding its delimiters, in Unicode code points."
        },
        "largestOptionFormulaLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Largest textual answer formula source length excluding delimiters."
        },
        "questionParagraphNum": {
          "type": "integer",
          "minimum": 0,
          "description": "question Paragraph Num. Counts use resolved, visible content; lengths use Unicode code points."
        },
        "responseParagraphNum": {
          "type": "integer",
          "minimum": 0,
          "description": "response Paragraph Num. Counts use resolved, visible content; lengths use Unicode code points."
        },
        "longestOptionWordLength": {
          "type": "integer",
          "minimum": 0,
          "description": "Longest prose word in visible textual options, excluding math and image labels."
        }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["id", "area", "area_id", "topic", "spec", "statement", "problem", "options", "correct_answer", "solution_steps", "hints", "formulas", "group_id", "visual_spec"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "set_id": { "type": "string" },
        "area": { "type": "string" },
        "area_id": { "enum": ["geometry", "functions", "statistics"] },
        "topic": { "type": "string" },
        "spec": { "$ref": "#/$defs/spec" },
        "statement": { "type": "string" },
        "problem": { "type": "string" },
        "options": {
          "type": "object",
          "required": ["A", "B", "C", "D"],
          "properties": {
            "A": { "type": "string" },
            "B": { "type": "string" },
            "C": { "type": "string" },
            "D": { "type": "string" }
          },
          "additionalProperties": false
        },
        "correct_answer": { "enum": ["A", "B", "C", "D"] },
        "solution_steps": { "type": "array", "items": { "type": "string" } },
        "hints": {
          "description": "Question-specific fundamental concepts, separate from solution steps.",
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["hint", "explanation"],
            "properties": {
              "hint": { "type": "string", "minLength": 1 },
              "explanation": { "type": "string", "minLength": 1 }
            }
          }
        },
        "formulas": {
          "description": "Relevant formulas with raw LaTeX, without delimiters. Empty when no formula is needed.",
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "formula", "explanation"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "formula": { "type": "string", "minLength": 1 },
              "explanation": { "type": "string", "minLength": 1 }
            }
          }
        },
        "group_id": { "type": ["string", "null"] },
        "visual_spec": { "$ref": "#/$defs/visual_spec" },
        "image": { "type": ["string", "null"] },
        "option_images": {
          "type": ["object", "null"],
          "properties": {
            "A": { "type": "string" },
            "B": { "type": "string" },
            "C": { "type": "string" },
            "D": { "type": "string" }
          },
          "additionalProperties": false
        },
        "flags": { "type": "array", "items": { "type": "string" } },
        "layoutCharacteristics": { "$ref": "#/$defs/layoutCharacteristics" }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": ["group_id", "items"],
      "properties": {
        "group_id": { "type": "string" },
        "items": { "type": "array", "items": { "type": "integer" } },
        "title": { "type": "string" },
        "context_text": { "type": ["string", "null"] },
        "visual_spec": { "$ref": "#/$defs/visual_spec" },
        "image": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["block", "affirmation", "evidence", "evidence_desc"],
      "properties": {
        "block": { "type": "string" },
        "affirmation": { "type": "string", "pattern": "^A[0-9]+$" },
        "affirmation_desc": { "type": ["string", "null"] },
        "evidence": { "type": "string", "pattern": "^A[0-9]+\\.[0-9]+$" },
        "evidence_desc": { "type": "string" }
      },
      "additionalProperties": false
    },
    "visual_spec": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["alt", "visual"],
          "properties": {
            "alt": { "type": "string" },
            "visual": { "$ref": "#/$defs/visual" }
          },
          "additionalProperties": false
        }
      ]
    },
    "visual": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "properties": { "type": { "const": "cartesian_2d" }, "domain": { "$ref": "#/$defs/domain" }, "children": { "type": "array", "items": { "$ref": "#/$defs/primitive" } } }, "additionalProperties": true },
        { "properties": { "type": { "const": "multi_view_grid" }, "layout": { "type": "object" }, "views": { "type": "array", "items": { "type": "object", "required": ["label", "visual"], "properties": { "label": { "type": "string" }, "visual": { "$ref": "#/$defs/visual" } } } } }, "additionalProperties": true },
        { "properties": { "type": { "const": "function_plot" }, "form": { "enum": ["linear", "quadratic", "piecewise", "sqrt", "exponential", "logarithmic"] }, "params": { "type": "object" }, "annotations": { "type": "object" } }, "additionalProperties": true },
        { "properties": { "type": { "const": "curve_region" }, "path": { "type": "object" }, "straight_segments": { "type": "array" }, "base": { "type": "object" } }, "additionalProperties": true },
        { "properties": { "type": { "const": "transformation_overlay" }, "figures": { "type": "array", "items": { "$ref": "#/$defs/primitive" } } }, "additionalProperties": true },
        { "properties": { "type": { "const": "table" }, "variant": { "enum": ["frequency", "weighted", "summary", "contingency", "stats"] } }, "additionalProperties": true },
        { "properties": { "type": { "const": "box_plot" }, "groups": { "type": "array" } }, "additionalProperties": true },
        { "properties": { "type": { "const": "distribution_curve" }, "skew": { "enum": ["negative", "positive", "symmetric"] } }, "additionalProperties": true },
        { "properties": { "type": { "const": "venn_diagram" }, "sets": { "type": "array" }, "region_values": { "type": "object" } }, "additionalProperties": true }
      ]
    },
    "domain": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
        "y": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
      },
      "additionalProperties": false
    },
    "primitive": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["point", "label", "circle", "line", "ray", "polyline", "path", "polygon", "dashed_projection", "arrow"] }
      },
      "additionalProperties": true
    }
  }
}